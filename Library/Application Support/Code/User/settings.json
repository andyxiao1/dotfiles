{
    // ================================================================================
    // Editor Settings
    // ================================================================================
    "editor.minimap.enabled": false,
    "editor.rulers": [
        80
    ],
    "editor.linkedEditing": true,
    "editor.lineNumbers": "relative", // Toggled with cmd+L via Settings Cycler.
    "editor.trimAutoWhitespace": false, // doesn't remove whitespace when hitting `esc` with vim.
    "editor.guides.bracketPairs": "active", // RIP Bracket Pair Colorizer
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "editor.tabCompletion": "on",
    "workbench.editor.enablePreview": false,
    "workbench.editor.splitInGroupLayout": "vertical",
    "explorer.sortOrder": "type", // Toggled with cmd+E via Settings Cycler.
    "explorer.confirmDelete": false,
    "window.confirmBeforeClose": "keyboardOnly",
    "security.workspace.trust.enabled": false,
    // ================================================================================
    // Theme / UI Settings
    // ================================================================================
    "workbench.colorTheme": "Dracula.min",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.colorCustomizations": {
        // ignore the "property is not allowed" warnings -- these do work
        "[Dracula.min]": {
            "editor.foldBackground": "#fff0",
            "activityBar.background": "#282a36",
            "editor.lineHighlightBackground": "#343746",
        }
    },
    "workbench.sideBar.location": "right",
    "workbench.startupEditor": "none",
    // ================================================================================
    // Terminal Settings
    // ================================================================================
    "terminal.integrated.fontFamily": "MesloLGS NF", // Necessary for p10k.
    // ================================================================================
    // Python Settings
    // ================================================================================
    // ruff for lint + format, pylance for types
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        },
        // 88 is ruff's default line length
        "editor.rulers": [
            88
        ],
        "vim.textwidth": 88,
    },
    "python.analysis.typeCheckingMode": "basic", // off by default. can bump to standard/strict
    // ================================================================================
    // Other Language / Extension Specific Settings
    // ================================================================================
    "[markdown]": {
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 80
    },
    // For some reason, {} works but null doesn't.
    "leaper.decorationOptions": {},
    // ================================================================================
    // Vim Settings
    // ================================================================================
    "editor.cursorSurroundingLines": 14, // Scrolloff
    "vim.camelCaseMotion.enable": true,
    "vim.leader": " ",
    "vim.foldfix": true,
    "vim.showMarksInGutter": true,
    "vim.visualModeKeyBindings": [
        {
            "before": [
                ">"
            ],
            "commands": [
                "editor.action.indentLines"
            ]
        },
        {
            "before": [
                "<"
            ],
            "commands": [
                "editor.action.outdentLines"
            ]
        },
    ],
    // ================================================================================
    // Better Comments Settings
    // ================================================================================
    "better-comments.tags": [
        {
            "tag": "!",
            "color": "#FF2D00",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            "tag": "?",
            "color": "#3498DB",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            "tag": "todo",
            "color": "#FF8C00",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            "tag": "*",
            "color": "#98C379",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            "tag": "nocommit",
            "color": "#FF8C00",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            "tag": "changeme",
            "color": "#FF8C00",
            "strikethrough": false,
            "backgroundColor": "transparent"
        }
    ],
}